generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum WorkerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum BookingType {
  INSTANT
  SCHEDULED
  EMERGENCY
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CUSTOMER
  RESOLVED_WORKER
  DISMISSED
}

enum DisputeReason {
  WORKER_DID_NOT_ARRIVE
  CUSTOMER_DID_NOT_PAY
  WRONG_SERVICE_PROVIDED
  FRAUD
  PROPERTY_DAMAGE
  MISCONDUCT
}

enum PaymentMethodType {
  EASYPAISA
  JAZZCASH
  SADAPAY
  NAYAPAY
  BANK_ACCOUNT
}

enum NotificationType {
  BOOKING_UPDATE
  CHAT_MESSAGE
  PROMOTION
  DISPUTE_UPDATE
  VERIFICATION_UPDATE
}

enum Language {
  ENGLISH
  URDU
  PUNJABI
  SINDHI
  PASHTO
  OTHER
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String?   @unique
  phone             String?   @unique
  phoneVerified     Boolean   @default(false) @map("phone_verified")
  passwordHash      String?   @map("password_hash")
  fullName          String    @map("full_name")
  profilePhoto      String?   @map("profile_photo")
  role              UserRole
  isGuest           Boolean   @default(false) @map("is_guest")
  guestExpiresAt    DateTime? @map("guest_expires_at")
  fcmToken          String?   @map("fcm_token")
  languagePreference Language @default(ENGLISH) @map("language_preference")
  isBlocked         Boolean   @default(false) @map("is_blocked")
  blockReason       String?   @map("block_reason")
  lastLoginAt       DateTime? @map("last_login_at")
  refreshTokenHash  String?   @map("refresh_token_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workerProfile      WorkerProfile?
  adminUser          AdminUser?
  customerBookings   Booking[]          @relation("CustomerBookings")
  sentMessages       ChatMessage[]      @relation("SenderMessages")
  receivedMessages   ChatMessage[]      @relation("ReceiverMessages")
  reviews            Review[]
  favorites          Favorite[]
  blockedWorkers     BlockedWorker[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  raisedDisputes     Dispute[]          @relation("DisputeRaiser")
  disputeEvidence    DisputeEvidence[]
  activityLogs       ActivityLog[]

  @@map("users")
}

model WorkerProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  cnicFront          String?      @map("cnic_front")
  cnicBack           String?      @map("cnic_back")
  cnicNumber         String?      @map("cnic_number")
  verificationStatus WorkerStatus @default(PENDING) @map("verification_status")
  verificationNotes  String?      @map("verification_notes")
  verifiedAt         DateTime?    @map("verified_at")
  verifiedBy         String?      @map("verified_by") @db.Uuid
  experienceYears    Int?         @map("experience_years")
  description        String?
  coverPhoto         String?      @map("cover_photo")
  responseTimeMinutes Int?        @map("response_time_minutes")
  isOnline           Boolean      @default(false) @map("is_online")
  workingHoursJson   Json?        @map("working_hours_json")
  languages          Language[]
  completedJobs      Int          @default(0) @map("completed_jobs")
  avgRating          Decimal      @default(0) @map("avg_rating") @db.Decimal(2, 1)
  totalReviews       Int          @default(0) @map("total_reviews")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id])
  portfolio         WorkerPortfolio[]
  paymentMethods    WorkerPaymentMethod[]
  serviceAreas      WorkerServiceArea[]
  workerServices    WorkerService[]
  workerBookings    Booking[]             @relation("WorkerBookings")
  reviews           Review[]
  favorites         Favorite[]
  blockedBy         BlockedWorker[]

  @@map("worker_profiles")
}

model WorkerPortfolio {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String   @map("worker_id") @db.Uuid
  mediaUrl  String   @map("media_url")
  mediaType String   @map("media_type")
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_portfolio")
}

model WorkerPaymentMethod {
  id            String            @id @default(uuid()) @db.Uuid
  workerId      String            @map("worker_id") @db.Uuid
  methodType    PaymentMethodType @map("method_type")
  accountNumber String            @map("account_number")
  accountTitle  String            @map("account_title")
  bankName      String?           @map("bank_name")
  isDefault     Boolean           @default(false) @map("is_default")
  createdAt     DateTime          @default(now()) @map("created_at")

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_payment_methods")
}

model WorkerServiceArea {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String   @map("worker_id") @db.Uuid
  city      String
  area      String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  radiusKm  Int?     @map("radius_km")
  createdAt DateTime @default(now()) @map("created_at")

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_service_areas")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameUr      String   @map("name_ur")
  iconUrl     String?  @map("icon_url")
  slug        String   @unique
  descriptionEn String? @map("description_en")
  descriptionUr String? @map("description_ur")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("categories")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  nameEn      String   @map("name_en")
  nameUr      String   @map("name_ur")
  slug        String   @unique
  iconUrl     String?  @map("icon_url")
  descriptionEn String? @map("description_en")
  descriptionUr String? @map("description_ur")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  workerServices  WorkerService[]
  bookings        Booking[]

  @@map("services")
}

model WorkerService {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String   @map("worker_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  worker  WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([workerId, serviceId])
  @@map("worker_services")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  workerId      String        @map("worker_id") @db.Uuid
  serviceId     String        @map("service_id") @db.Uuid
  bookingType   BookingType   @map("booking_type")
  status        BookingStatus @default(PENDING)
  description   String
  scheduledAt   DateTime?     @map("scheduled_at")
  address       String
  latitude      Decimal       @db.Decimal(10, 7)
  longitude     Decimal       @db.Decimal(10, 7)
  customerNotes String?       @map("customer_notes")
  workerNotes   String?       @map("worker_notes")
  priceEstimate Decimal?      @map("price_estimate") @db.Decimal(12, 2)
  expiryAt      DateTime      @map("expiry_at")
  acceptedAt    DateTime?     @map("accepted_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelledBy   UserRole?     @map("cancelled_by")
  cancelReason  String?       @map("cancel_reason")
  isDisputed    Boolean       @default(false) @map("is_disputed")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer    User          @relation("CustomerBookings", fields: [customerId], references: [id])
  worker      WorkerProfile @relation("WorkerBookings", fields: [workerId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  review      Review?
  disputes    Dispute[]
  chatMessages ChatMessage[]

  @@map("bookings")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  rating     Int
  comment    String?
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking       @relation(fields: [bookingId], references: [id])
  customer User          @relation(fields: [customerId], references: [id])
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  @@map("reviews")
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  raisedBy        String        @map("raised_by") @db.Uuid
  raisedByRole    UserRole      @map("raised_by_role")
  reason          DisputeReason
  description     String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @map("resolution_notes")
  resolvedBy      String?       @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?     @map("resolved_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking  Booking          @relation(fields: [bookingId], references: [id])
  raiser   User             @relation("DisputeRaiser", fields: [raisedBy], references: [id])
  evidence DisputeEvidence[]

  @@map("disputes")
}

model DisputeEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")

  dispute  Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@map("dispute_evidence")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer User          @relation(fields: [customerId], references: [id])
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([customerId, workerId])
  @@map("favorites")
}

model BlockedWorker {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer User          @relation(fields: [customerId], references: [id])
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([customerId, workerId])
  @@map("blocked_workers")
}

model ChatMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  receiverId  String    @map("receiver_id") @db.Uuid
  bookingId   String?   @map("booking_id") @db.Uuid
  message     String
  messageType String    @default("TEXT") @map("message_type")
  fileUrl     String?   @map("file_url")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender   User     @relation("SenderMessages", fields: [senderId], references: [id])
  receiver User     @relation("ReceiverMessages", fields: [receiverId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@map("chat_messages")
}

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  resolvedBy  String?  @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("support_tickets")
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String
  body          String
  data          Json?            @map("data")
  isRead        Boolean          @default(false) @map("is_read")
  isPushedViaFcm Boolean         @default(false) @map("is_pushed_via_fcm")
  fcmMessageId  String?          @map("fcm_message_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Banner {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  imageUrl       String     @map("image_url")
  redirectTo     String?    @map("redirect_to")
  targetAudience UserRole[] @map("target_audience")
  isActive       Boolean    @default(true) @map("is_active")
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  sortOrder      Int        @default(0) @map("sort_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("banners")
}

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adminUsers AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id])
  role AdminRole @relation(fields: [roleId], references: [id])

  @@map("admin_users")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("activity_logs")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
