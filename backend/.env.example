NODE_ENV=development
PORT=3000
APP_NAME=Arslan Services

# Database (NeonDB)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis (Upstash)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_SECRET=ajhyhtg876yhnjuyhtgrfeeolkijuhygtfr876543256789ikmnhytgvcfrde
JWT_REFRESH_SECRET=ujnhybgtvfrcfrgthyjukih76yhnhtgrfekijuhygtfr87655678mnhytgcre
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Mapbox
MAPBOX_PUBLIC_TOKEN=pk.your_public_token
MAPBOX_SECRET_KEY=sk.your_secret_key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Firebase FCM (only Cloud Messaging)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (OTP)
RESEND_API_KEY=re_your_resend_api_key
OTP_EXPIRY_MINUTES=5

# WhatsApp Business (future)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# CORS
ADMIN_PANEL_URL=http://localhost:5173
